firtscript.js


let carCollection = [];
const headers = "<tr><th>Car number</th><th>Date</th></tr>"
function SaveVisit() {
    let t = document.getElementById("tab1");
    let inp2 = document.getElementById("date1");
    let inp1 = document.getElementById("numb1");
    if (inp1 != null && inp1.value != null && inp2 != null && inp2.valueAsDate != null) {
        carCollection.push({
            carNumb: inp1.value,
            date: inp2.valueAsDate
        });
    }

    if (t != null) {
        let table1 = headers;
        if (carCollection.length > 0) {
            for (let i = 0; i < carCollection.length; i++) {
                table1 += "<tr><td>" + carCollection[i].carNumb + "</td><td>" + carCollection[i].date.toISOString() + "</td></tr>";
            }
        }
        t.innerHTML = table1;
    }
}


